# Copie ce fichier en .env puis adapte-le.

# Port et adresse d'écoute sur le serveur. 127.0.0.1 = local uniquement (derrière un reverse proxy ou un tunnel).
PORT=3000
BIND_ADDRESS=127.0.0.1

# Mot de passe de l'interface web (authentification HTTP basique). Vide = pas de mot de passe :
# à réserver à un accès via Tailscale / Cloudflare Access.
APP_USER=moi
APP_PASSWORD=

# Jeton du serveur MCP. Vide = généré au premier démarrage (visible dans Réglages et dans data/mcp-token.txt).
MCP_TOKEN=

# Sauvegardes : dossier de destination, nombre conservé, heure de la sauvegarde quotidienne.
BACKUP_PATH=./backups
BACKUP_KEEP=30
BACKUP_HOUR=3
